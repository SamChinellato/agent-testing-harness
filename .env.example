# .env.example - Copy to .env and fill in your values

# 1. MaaS Gateway & Model Endpoint
# Either set MAAS_ENDPOINT directly:
MAAS_ENDPOINT=
# Or set MAAS_HOST and MODEL_PATH separately:
# MAAS_HOST=maas-gateway.openshift-ai.apps.example.com
# MODEL_PATH=/models-as-a-service/granite-3-1-2b-instruct

# Model Name
MODEL_NAME=granite-3.1-2b-instruct

# 2. Authentication & Identity
MAAS_API_KEY=
USER_ID=user-a
TEAM_ID=team-alpha

# 3. Dashboard URL
DASHBOARD_URL=http://localhost:8000

# 4. Rate Limiting Defaults
LIMIT_TPM=2000
