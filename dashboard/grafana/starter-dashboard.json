{
  "uid": "maas-agent-harness",
  "title": "MaaS Agent Harness \u2014 Load Test Overview",
  "description": "Starter dashboard for the agent testing harness /metrics endpoint (Phase 4).",
  "tags": [
    "maas",
    "load-testing",
    "llm"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second, by worker",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (worker) (rate(agent_harness_requests_total[1m]))",
          "legendFormat": "{{worker}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Tokens per second, by worker and direction",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (worker, direction) (rate(agent_harness_tokens_total[1m]))",
          "legendFormat": "{{worker}} {{direction}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 end-to-end latency (ms)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "agent_harness_request_duration_ms{quantile=\"0.95\"}",
          "legendFormat": "{{worker}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "p95 time to first token (ms)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "agent_harness_ttft_ms{quantile=\"0.95\"}",
          "legendFormat": "{{worker}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Throttle rate (429 share of requests)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (worker) (rate(agent_harness_requests_total{status=\"429\"}[1m])) / sum by (worker) (rate(agent_harness_requests_total[1m]))",
          "legendFormat": "{{worker}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Dropped iterations per second (open-model saturation)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (worker) (rate(agent_harness_dropped_iterations_total[1m]))",
          "legendFormat": "{{worker}}"
        }
      ]
    }
  ]
}
